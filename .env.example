# Use keys from the SAME Clerk application for the website and future DAW login.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_WAITLIST_URL=/waitlist
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Enable only after configuring Clerk Billing, Stripe, and your subscription plan.
CLERK_BILLING_ENABLED=false

# Paid user plans, no free trials (prices in lib/daw-subscription.ts).
# Standard: USD $20/month, $204/year, $10 of Awma a month.
CLERK_DAW_STANDARD_PLAN_ID=
# Extended: USD $50/month, $540/year, $40 of Awma a month.
CLERK_DAW_EXTENDED_PLAN_ID=

# Desktop app and Awma (see docs/desktop.md)
# Anthropic key used by the Awma proxy; never sent to the app.
ANTHROPIC_API_KEY=
# Convex: usage, rate limits, entitlement cache. `bunx convex dev` sets the first two.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Shared with the Convex deployment (`bunx convex env set CONVEX_SERVER_SECRET …`).
CONVEX_SERVER_SECRET=
