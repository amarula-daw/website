# Use keys from the SAME Clerk application for the website and future DAW login.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_WAITLIST_URL=/waitlist
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Enable only after configuring Clerk Billing, Stripe, and your subscription plan.
CLERK_BILLING_ENABLED=false

# The subscription, no free trial (prices in lib/daw-subscription.ts).
# Awma + Cloud: USD $20/month, $200/year, $7 of Awma a month.
CLERK_AWMA_PLAN_ID=

# One-time purchases through Stripe Checkout (lib/stripe.ts).
STRIPE_SECRET_KEY=
# The signing secret of the endpoint for /api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# charge.refunded, charge.dispute.created).
STRIPE_WEBHOOK_SECRET=
# One-time Prices: the DAW's lifetime license (USD $99) and an Awma pack (USD $10).
STRIPE_LICENSE_PRICE_ID=
STRIPE_AWMA_PACK_PRICE_ID=

# Desktop app and Awma (see docs/desktop.md)
# Anthropic key used by the Awma proxy; never sent to the app.
ANTHROPIC_API_KEY=
# Convex: usage, rate limits, entitlement cache. `bunx convex dev` sets the first two.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Shared with the Convex deployment (`bunx convex env set CONVEX_SERVER_SECRET …`).
CONVEX_SERVER_SECRET=
